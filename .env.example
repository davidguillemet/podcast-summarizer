# Which model writes the summaries: "claude" (API, best long-episode coverage),
# "mistral" (API, hosted Mistral Large) or "local" (Mistral Small 3.2 24B via
# llama.cpp — free, offline, private). Transcription is always local either way.
SUMMARIZER=claude

# Required only when SUMMARIZER=claude.
ANTHROPIC_API_KEY=sk-ant-...

# Required only when SUMMARIZER=mistral. Get one at https://console.mistral.ai/api-keys.
MISTRAL_API_KEY=sk-mis-...
# Optional — defaults to mistral-large-latest.
MISTRAL_MODEL=mistral-large-latest

# Optional — Podcast Index (free key from https://podcastindex.org/api).
# Without these the app still works, using iTunes search only.
PODCASTINDEX_KEY=
PODCASTINDEX_SECRET=

# Server. Avoid 3000 (CRA) and 4000/5002/5003/9099/9199 (Firebase emulators).
PORT=4300

# Whisper model: tiny | base | small | medium | large-v3-turbo
# large-v3-turbo is the best accuracy/speed balance on Apple silicon.
WHISPER_MODEL=large-v3-turbo

# iTunes storefront used for search results (fr, us, gb, ...)
ITUNES_COUNTRY=fr

# --- Local summarizer (only used when SUMMARIZER=local) ---
LOCAL_MODEL_FILE=Mistral-Small-3.2-24B-Instruct-2506-Q4_K_M.gguf
LLAMA_PORT=8110
# 32768 fits alongside the Q4 weights in 26.8 GB of GPU memory with a q8_0 KV cache.
# Transcripts longer than this are summarized by map-reduce, not truncated.
LLAMA_CONTEXT=32768
# Unload the 13 GB model after this many idle minutes (0 disables).
LLAMA_IDLE_MINUTES=15
